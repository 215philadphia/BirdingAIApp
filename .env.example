# Copy to .env and fill in. Both keys are optional: without them the app still
# identifies birds, it just skips the extra features below.

# eBird (Cornell Lab): marks species that were recently reported near the user.
# Free key: https://ebird.org/api/keygen
EBIRD_API_KEY=

# xeno-canto: plays reference recordings of each identified species.
# Free key from your account page on https://xeno-canto.org
XENOCANTO_API_KEY=

# Optional settings
# DATA_DIR=data
# MIN_CONFIDENCE=0.25
# MAX_UPLOAD_MB=25
